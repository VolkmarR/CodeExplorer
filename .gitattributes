# Text is stored LF in the repository and checked out in the platform's line ending: CRLF on
# Windows and LF elsewhere. No global `eol`, so each checkout follows its own platform rather than
# this file. .editorconfig names no ending and oxfmt takes the checkout's (CODING_STANDARDS.md).
* text=auto

# cmd.exe misreads labels and `goto` in a batch file with bare LF line endings, so the evaluation
# package's scripts keep CRLF whatever the checkout's core.autocrlf says.
*.cmd text eol=crlf

# Never converted, whatever text=auto would guess from their first bytes.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.duckdb binary
*.parquet binary
