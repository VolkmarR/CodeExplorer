root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,ts,tsx,js,jsx,css,html,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0005.severity = warning # unnecessary using

# var: yes, except for built-in types used as counters and accumulators
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Modern C# the codebase already leans on
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion

# Types are sealed unless designed for inheritance
dotnet_diagnostic.CA1852.severity = warning # seal internal types

# Correctness rules worth failing on
dotnet_diagnostic.CA2016.severity = warning # forward CancellationToken
dotnet_diagnostic.CA2007.severity = none # ConfigureAwait: not used in ASP.NET Core
dotnet_diagnostic.CA1848.severity = none # LoggerMessage delegates: not worth it here
dotnet_diagnostic.CA1031.severity = suggestion # catch-all is allowed where commented

# Accessibility and naming
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case
# An application, not a library consumed from VB: namespaces follow folders, and "Operator" is a
# domain term (CONTEXT.md). Type and member names are still checked.
dotnet_code_quality.CA1716.analyzed_symbol_kinds = NamedType, Method, Property, Event, Parameter

[CodeExplorer.Tests/**.cs]
# Test names read as sentences; underscores are the convention there
dotnet_diagnostic.CA1707.severity = none
