        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CodeExplorer/CodeExplorer.csproj"/>
        <ProjectReference Include="../CodeExplorer.McpProxy/CodeExplorer.McpProxy.csproj"/>
    </ItemGroup>

</Project>
